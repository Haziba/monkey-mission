[node name="Btn9" type="Button" parent="Sheet/Panel/Pad/Body/Menu"]
custom_minimum_size = Vector2(0, 132)
layout_mode = 2
size_flags_horizontal = 3
text = "ROSTER"

; Added by the Verification agent. Dossier §5 [C]: BOTH hunger extremes
; immobilise the monkey. Every other slot-consuming entry above is gated on the
; monkey being able to act, so a stuffed or starving monkey could not move the
; clock at all — it never digested, and Economy.check_bailout() (which only runs
; at the top of a day) could never fire. REST spends the half-day and nothing
; else, which is the cost of overfeeding rather than an escape from it.

[node name="Btn10" type="Button" parent="Sheet/Panel/Pad/Body/Menu"]
custom_minimum_size = Vector2(0, 132)
layout_mode = 2
size_flags_horizontal = 3
text = "REST"
