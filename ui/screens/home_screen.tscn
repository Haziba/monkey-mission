[node name="Card" parent="Root/Col" instance=ExtResource("3_card")]
layout_mode = 2

; The eleven activity buttons used to sit inline in this column. At 132px each
; in two columns they were 900px of an 1920px screen, which squeezed the room
; scene to nothing and pushed the last row off the bottom edge. They now live in
; a sheet that slides up over the screen when ACTIONS is pressed.


; Anchored to the window rather than sitting in the padded column, so it stays
; flush against the bottom edge on any aspect ratio instead of floating above
; the safe-area inset. Root's bottom margin is widened to match its height so
; the stat card is never hidden behind it.

