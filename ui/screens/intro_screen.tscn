[gd_scene load_steps=3 format=3]

; Prologue screen: protagonist picker, then the data-driven intro dialogue.
; Portrait 1080x1920. Every colour is applied from ui/theme/palette.gd in
; intro_screen.gd — nothing here bakes a Color.

[ext_resource type="Script" path="res://ui/screens/intro_screen.gd" id="1_intro"]
[ext_resource type="PackedScene" path="res://ui/components/dialogue_box.tscn" id="2_dialogue"]

[node name="IntroScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_intro")

[node name="Bg" type="ColorRect" parent="."]
